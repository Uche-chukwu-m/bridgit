# Everything here is optional. Bridgit works out of the box with public OpenStreetMap services.

# Point these at your own instances for heavier use (the public ones are rate limited).
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# PHOTON_URL=https://photon.komoot.io

# Photo height estimates. Any OpenAI-compatible vision model works; the default is NVIDIA's hosted API.
# VISION_API_KEY=
# VISION_API_URL=https://integrate.api.nvidia.com/v1
# VISION_MODEL=meta/llama-3.2-90b-vision-instruct
